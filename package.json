{
  "name": "ultimate-studios-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "migrate:sanity": "npx --yes tsx scripts/migrate-posts-to-sanity.ts",
    "migrate:body": "npx --yes tsx scripts/migrate-content-to-body.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@portabletext/react": "^8.0.1",
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^5.31.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "fast-xml-parser": "^5.11.0",
    "gsap": "^3.15.0",
    "mammoth": "^1.12.3",
    "next": "^16.4.2",
    "next-sanity": "^13.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^5.31.2",
    "styled-components": "^6.5.3",
    "swiper": "^14.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "wrangler": "^4.151.3"
  }
}
